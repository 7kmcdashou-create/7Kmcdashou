{
  "name": "Hermes Agent",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    9119
  ],
  "portsAttributes": {
    "9119": {
      "label": "Hermes Dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "nohup bash /workspaces/7Kmcdashou/deploy.sh > /tmp/hermes-deploy.log 2>&1 &",
  "remoteUser": "vscode"
}